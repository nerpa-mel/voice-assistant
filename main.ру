class VoiceAssistant:
    def __init__(self, name="ВИБ"):
        self.name = name
        self.recognizer = sr.Recognizer()
        self.microphone = sr.Microphone()
        self.temp_dir = Path("temp_audio")
        self.temp_dir.mkdir(exist_ok=True)
        self.exit_flag = False

    def speak(self, text):
        if not text: return
        print(f"{self.name}: {text}")
        try:
            engine = pyttsx3.init()
            engine.setProperty('rate', 150)
            for voice in engine.getProperty('voices'):
                if 'russian' in str(voice.languages).lower():
                    engine.setProperty('voice', voice.id)
                    break
            engine.say(text)
            engine.runAndWait()
        except:
            try:
                tts = gTTS(text=text, lang="ru", slow=False)
                audio_path = self.temp_dir / "response.mp3"
                tts.save(str(audio_path))
                playsound(str(audio_path))
                audio_path.unlink(missing_ok=True)
            except Exception as e:
                print(f"Ошибка: {e}")

    def listen(self):
        with self.microphone as source:
            self.recognizer.adjust_for_ambient_noise(source, duration=0.5)
            try:
                audio = self.recognizer.listen(source, timeout=5, phrase_time_limit=10)
                return self.recognizer.recognize_google(audio, language="ru-RU").lower()
            except: return None

    def run(self):
        print(f"=== {self.name} ===")
        self.speak(f"Привет! Я {self.name}. Как я могу помочь?")
        while not self.exit_flag:
            text = self.listen()
            if text:
                print(f"Вы: {text}")
                if any(w in text for w in ["выход", "пока", "стоп"]):
                    self.speak("До свидания!")
                    self.exit_flag = True
                elif any(w in text for w in ["привет", "здравствуй"]):
                    self.speak(f"Привет! Я {self.name}.")
                elif any(w in text for w in ["который час", "время"]):
                    self.speak(f"Сейчас {datetime.now().strftime('%H:%M')}")
                elif "дата" in text:
                    self.speak(f"Сегодня {datetime.now().strftime('%d %B %Y года')}")
                elif "открой сайт" in text:
                    sites = {"ютуб":"https://youtube.com", "гугл":"https://google.com", "вк":"https://vk.com"}
                    for name, url in sites.items():
                        if name in text:
                            self.speak(f"Открываю {name}")
                            webbrowser.open(url)
                            break
                elif "поиск" in text:
                    query = text.replace("поиск", "").strip()
                    if query:
                        self.speak(f"Ищу {query}")
                        webbrowser.open(f"https://google.com/search?q={query}")
                elif "шутка" in text:
                    self.speak("Почему программисты путают Рождество и Хэллоуин? Потому что OCT 31 = DEC 25!")
                elif any(w in text for w in ["рассчитай", "посчитай"]):
                    expr = text.replace("рассчитай", "").replace("посчитай", "").strip()
                    expr = expr.replace("плюс", "+").replace("минус", "-")
                    expr = ''.join(c for c in expr if c in '0123456789+- ')
                    try:
                        result = eval(expr)
                        self.speak(f"Результат: {result}")
                    except:
                        self.speak("Не удалось вычислить")

if __name__ == "__main__":
    VoiceAssistant(name="ВИБ").run()
